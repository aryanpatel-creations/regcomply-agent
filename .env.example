# Copy to .env and edit. Never commit .env to GitHub.
LLM_PROVIDER=ollama               # ollama | openai_compat
CHAT_MODEL=qwen3.5:9b             # 8 GB laptop: llama3.2:3b
EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434
# Free hosted option instead of Ollama (pick one):
# LLM_PROVIDER=openai_compat
# API_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=<a model id from your Groq console>
# API_KEY=<your key>
RETRIEVER=hybrid                  # cloud demo without Ollama: bm25
MCP_URL=http://localhost:8001/mcp
APPROVAL_SECRET=replace-with-a-long-random-string
